{
  "name": "@wd/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:static": "vue-tsc --noEmit && vite build --mode static",
