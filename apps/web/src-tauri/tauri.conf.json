{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "江巷灌区数字孪生平台",
  "version": "0.1.0",
  "identifier": "com.waterdisplay.jiangxiang",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:static"
  },
  "app": {
    "windows": [
      {
        "title": "江巷灌区数字孪生平台",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
