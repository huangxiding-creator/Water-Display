# 复制为 .env.local 并填入你的值 / Copy to .env.local and fill in.
# 切勿提交 .env.local / Never commit .env.local.

# 智谱 BigModel API Key (https://bigmodel.cn 控制台获取)
VITE_ZHIPU_API_KEY=

# 默认模型：glm-4.5-flash (免费) 或 glm-5.2 (收费)
VITE_ZHIPU_MODEL=glm-4.5-flash

# 智谱 API 端点
VITE_ZHIPU_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
